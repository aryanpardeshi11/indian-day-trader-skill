# ==============================================================================
# Indian Day Trader Skill (nse-bse-hybrid-trader) — Local Broker Credentials
# ==============================================================================
# SECURITY NOTICE:
# 1. Copy this file to `.env` locally (never commit `.env` to git!).
# 2. NEVER paste API keys, MPINs, passwords, or TOTP secrets into AI chat.
# 3. Paper trading (`--paper`, default) and offline/live Yahoo analysis do NOT
#    require any broker credentials or demat account.
# 4. Only populate the variables for the broker you actually use if opting into
#    gated live dispatch (`--live --confirm "CONFIRM LIVE"`).
# ==============================================================================

# --- Angel One SmartAPI (--broker angel_one) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# --- Zerodha Kite Connect v3 (--broker zerodha) ---
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# --- Upstox API v3 (--broker upstox) ---
UPSTOX_ACCESS_TOKEN=

# --- DhanHQ API v2 (--broker dhan) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Fyers API v3 (--broker fyers) ---
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# --- Groww Trading API v1 (--broker groww) ---
GROWW_ACCESS_TOKEN=

# --- Kotak Neo Trade API (--broker kotak_neo) ---
KOTAK_ACCESS_TOKEN=
KOTAK_SID=
KOTAK_BASE_URL=https://gw-napi.kotaksecurities.com

# --- ICICI Direct Breeze API v1 (--broker icici_breeze) ---
ICICI_API_KEY=
ICICI_SECRET_KEY=
ICICI_SESSION_TOKEN=

# --- Finvasia Shoonya Noren API (--broker shoonya) ---
SHOONYA_USER_ID=
SHOONYA_ACCOUNT_ID=
SHOONYA_SESSION_TOKEN=
